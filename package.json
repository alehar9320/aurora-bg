{
  "name": "aurora-bg",
  "version": "0.1.0",
  "description": "Native Web aurora borealis background animation — framework-agnostic, zero dependencies",
  "type": "module",
  "main": "./dist/aurora.umd.js",
  "module": "./dist/aurora.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aurora.esm.js",
      "require": "./dist/aurora.umd.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c rollup.config.mjs",
    "build": "npm run build:types && npm run build:js",
    "dev": "rollup -c rollup.config.mjs -w",
    "dev:example": "rollup -c rollup.config.mjs -w --environment SERVE",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "keywords": [
    "aurora",
    "borealis",
    "northern-lights",
    "aurora-borealis",
    "background",
    "animation",
    "canvas",
    "web-component",
    "custom-element",
    "aurora-bg",
    "particles",
    "gradient",
    "animated-background",
    "hero-background",
    "canvas-animation",
    "framework-agnostic",
    "no-dependencies"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "rollup": "^4.60.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
